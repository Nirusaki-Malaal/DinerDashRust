<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nirusaki.dinerdash" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application android:label="Diner Dash" android:icon="@mipmap/ic_launcher"
        android:description="@string/author_credit" android:hasCode="true"
        android:allowBackup="true" android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <meta-data android:name="author" android:value="Made by Nirusaki" />
        <meta-data android:name="description" android:value="Made by Nirusaki" />
        <meta-data android:name="credits" android:value="Made by Nirusaki" />
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
