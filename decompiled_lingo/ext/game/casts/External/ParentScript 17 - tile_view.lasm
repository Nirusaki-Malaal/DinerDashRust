property Tile, node
global glob

on new me, Args
  [  0] getparam 1 .............................. <Args>
  [  2] getobjprop 262 .......................... <Args.Tile>
  [  5] setprop 262 ............................. Tile = Args.Tile
  [  8] getparam 1 .............................. <Args>
  [ 10] getobjprop 45 ........................... <Args.node>
  [ 12] setprop 45 .............................. node = Args.node
  [ 14] getprop 262 ............................. <Tile>
  [ 17] getprop 45 .............................. <node>
  [ 19] setobjprop 45 ........................... Tile.node = node
  [ 21] getparam 0 .............................. <me>
  [ 23] pusharglistnoret 1 ...................... <me>
  [ 25] extcall 9 ............................... return me
  [ 27] ret
end

on setTile me, t
  [  0] getprop 262 ............................. <Tile>
  [  3] getparam 1 .............................. <t>
  [  5] eq ...................................... <Tile = t>
  [  6] jmpifz [ 13] ............................ if Tile = t then
  [  9] pusharglistnoret 0 ...................... <>
  [ 11] extcall 9 ............................... return 
  [ 13] getparam 1 .............................. <t>
  [ 15] setprop 262 ............................. Tile = t
  [ 18] getprop 262 ............................. <Tile>
  [ 21] pusharglist 1 ........................... <Tile>
  [ 23] extcall 31 .............................. <voidp(Tile)>
  [ 25] jmpifz [ 35] ............................ if voidp(Tile) then
  [ 28] getprop 45 .............................. <node>
  [ 30] pushzero ................................ <0>
  [ 31] pusharglistnoret 2 ...................... <node, 0>
  [ 33] objcall 57 .............................. node.setVisible(0)
  [ 35] ret
end

on destroy me
  [  0] pusharglist 0 ........................... <>
  [  2] extcall 65 .............................. <VOID>
  [  4] setprop 262 ............................. Tile = VOID
  [  7] getprop 45 .............................. <node>
  [  9] pusharglist 1 ........................... <node>
  [ 11] extcall 31 .............................. <voidp(node)>
  [ 13] jmpifz [ 20] ............................ if voidp(node) then
  [ 16] pusharglistnoret 0 ...................... <>
  [ 18] extcall 9 ............................... return 
  [ 20] getprop 45 .............................. <node>
  [ 22] pusharglistnoret 1 ...................... <node>
  [ 24] objcall 5 ............................... node.destroy()
  [ 26] pusharglist 0 ........................... <>
  [ 28] extcall 65 .............................. <VOID>
  [ 30] setprop 45 .............................. node = VOID
  [ 32] ret
end
