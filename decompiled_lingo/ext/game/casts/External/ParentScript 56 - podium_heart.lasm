property home, node, minY, speed, ploc, moving
global glob

on new me, n
  [  0] getparam 1 .............................. <n>
  [  2] setprop 45 .............................. node = n
  [  4] getprop 45 .............................. <node>
  [  6] pusharglist 1 ........................... <node>
  [  8] objcall 51 .............................. <node.getLoc()>
  [ 10] setprop 244 ............................. home = node.getLoc()
  [ 12] getprop 244 ............................. <home>
  [ 14] pusharglist 1 ........................... <home>
  [ 16] objcall 405 ............................. <home.duplicate()>
  [ 19] setprop 1141 ............................ ploc = home.duplicate()
  [ 22] pushint16 300 ........................... <300>
  [ 25] inv ..................................... <-300>
  [ 26] setprop 1142 ............................ minY = -300
  [ 29] getparam 0 .............................. <me>
  [ 31] pusharglistnoret 1 ...................... <me>
  [ 33] extcall 9 ............................... return me
  [ 35] ret
end

on changeSpeed me
  [  0] pushint8 20 ............................. <20>
  [  2] pusharglist 1 ........................... <20>
  [  4] extcall 639 ............................. <random(20)>
  [  7] pushfloat32 5.0 ......................... <5.0>
  [ 12] div ..................................... <random(20) / 5.0>
  [ 13] pushint8 2 .............................. <2>
  [ 15] sub ..................................... <(random(20) / 5.0) - 2>
  [ 16] pushfloat32 3.0 ......................... <3.0>
  [ 21] inv ..................................... <-3.0>
  [ 22] pushint8 10 ............................. <10>
  [ 24] pusharglist 1 ........................... <10>
  [ 26] extcall 639 ............................. <random(10)>
  [ 29] pushfloat32 5.0 ......................... <5.0>
  [ 34] div ..................................... <random(10) / 5.0>
  [ 35] sub ..................................... <-3.0 - (random(10) / 5.0)>
  [ 36] pusharglist 2 ........................... <(random(20) / 5.0) - 2, -3.0 - (random(10) / 5.0)>
  [ 38] extcall 361 ............................. <point((random(20) / 5.0) - 2, -3.0 - (random(10) / 5.0))>
  [ 41] setprop 824 ............................. speed = point((random(20) / 5.0) - 2, -3.0 - (random(10) / 5.0))
  [ 44] ret
end

on setVisible me, v
  [  0] getprop 45 .............................. <node>
  [  2] getparam 1 .............................. <v>
  [  4] pusharglistnoret 2 ...................... <node, v>
  [  6] objcall 57 .............................. node.setVisible(v)
  [  8] ret
end

on fire me
  [  0] pushint16 2000 .......................... <2000>
  [  3] pusharglist 1 ........................... <2000>
  [  5] extcall 639 ............................. <random(2000)>
  [  8] pushsymb 34 ............................. <#target>
  [ 10] getparam 0 .............................. <me>
  [ 12] pushsymb 33 ............................. <#handler>
  [ 14] pushsymb 253 ............................ <#start>
  [ 16] pusharglist 4 ........................... <[#target: me, #handler: #start]>
  [ 18] pushproplist ............................ <[#target: me, #handler: #start]>
  [ 19] pusharglistnoret 2 ...................... <random(2000), [#target: me, #handler: #start]>
  [ 21] extcall 252 ............................. timedCall(random(2000), [#target: me, #handler: #start])
  [ 23] ret
end

on start me
  [  0] getprop 45 .............................. <node>
  [  2] pusharglist 1 ........................... <node>
  [  4] extcall 31 .............................. <voidp(node)>
  [  6] jmpifz [ 13] ............................ if voidp(node) then
  [  9] pusharglistnoret 0 ...................... <>
  [ 11] extcall 9 ............................... return 
  [ 13] getprop 1141 ............................ <ploc>
  [ 16] pushint8 1 .............................. <1>
  [ 18] getprop 244 ............................. <home>
  [ 20] pushint8 1 .............................. <1>
  [ 22] pusharglist 2 ........................... <home, 1>
  [ 24] objcall 36 .............................. <home[1]>
  [ 26] pusharglistnoret 3 ...................... <ploc, 1, home[1]>
  [ 28] objcall 25 .............................. ploc[1] = home[1]
  [ 30] getprop 1141 ............................ <ploc>
  [ 33] pushint8 2 .............................. <2>
  [ 35] getprop 244 ............................. <home>
  [ 37] pushint8 2 .............................. <2>
  [ 39] pusharglist 2 ........................... <home, 2>
  [ 41] objcall 36 .............................. <home[2]>
  [ 43] pusharglistnoret 3 ...................... <ploc, 2, home[2]>
  [ 45] objcall 25 .............................. ploc[2] = home[2]
  [ 47] getparam 0 .............................. <me>
  [ 49] pusharglistnoret 1 ...................... <me>
  [ 51] objcall 1140 ............................ me.changeSpeed()
  [ 54] pushint8 1 .............................. <1>
  [ 56] setprop 1143 ............................ moving = 1
  [ 59] getparam 0 .............................. <me>
  [ 61] pushsymb 117 ............................ <#exitFrame>
  [ 63] pusharglistnoret 2 ...................... <me, #exitFrame>
  [ 65] extcall 100 ............................. subscribe(me, #exitFrame)
  [ 67] ret
end

on exitFrame me
  [  0] getprop 1143 ............................ <moving>
  [  3] not ..................................... <not moving>
  [  4] jmpifz [ 11] ............................ if not moving then
  [  7] pusharglistnoret 0 ...................... <>
  [  9] extcall 9 ............................... return 
  [ 11] pushint8 5 .............................. <5>
  [ 13] pusharglist 1 ........................... <5>
  [ 15] extcall 639 ............................. <random(5)>
  [ 18] pushint8 1 .............................. <1>
  [ 20] eq ...................................... <random(5) = 1>
  [ 21] jmpifz [ 31] ............................ if random(5) = 1 then
  [ 24] getparam 0 .............................. <me>
  [ 26] pusharglistnoret 1 ...................... <me>
  [ 28] objcall 1140 ............................ me.changeSpeed()
  [ 31] getprop 1141 ............................ <ploc>
  [ 34] pushint8 2 .............................. <2>
  [ 36] pusharglist 2 ........................... <ploc, 2>
  [ 38] objcall 36 .............................. <ploc[2]>
  [ 40] getprop 1142 ............................ <minY>
  [ 43] lt ...................................... <ploc[2] < minY>
  [ 44] jmpifz [ 53] ............................ if ploc[2] < minY then
  [ 47] getparam 0 .............................. <me>
  [ 49] pusharglistnoret 1 ...................... <me>
  [ 51] objcall 253 ............................. me.start()
  [ 53] getprop 1141 ............................ <ploc>
  [ 56] getprop 824 ............................. <speed>
  [ 59] add ..................................... <ploc + speed>
  [ 60] setprop 1141 ............................ ploc = ploc + speed
  [ 63] getprop 45 .............................. <node>
  [ 65] getprop 45 .............................. <node>
  [ 67] pusharglist 1 ........................... <node>
  [ 69] objcall 1144 ............................ <node.getRotation()>
  [ 72] pushint8 20 ............................. <20>
  [ 74] add ..................................... <node.getRotation() + 20>
  [ 75] pusharglistnoret 2 ...................... <node, node.getRotation() + 20>
  [ 77] objcall 949 ............................. node.setRotation(node.getRotation() + 20)
  [ 80] getprop 45 .............................. <node>
  [ 82] getprop 1141 ............................ <ploc>
  [ 85] pusharglistnoret 2 ...................... <node, ploc>
  [ 87] objcall 135 ............................. node.setLoc(ploc)
  [ 89] ret
end

on stop me
  [  0] getparam 0 .............................. <me>
  [  2] pushsymb 117 ............................ <#exitFrame>
  [  4] pusharglistnoret 2 ...................... <me, #exitFrame>
  [  6] extcall 105 ............................. unsubscribe(me, #exitFrame)
  [  8] pushzero ................................ <0>
  [  9] setprop 1143 ............................ moving = 0
  [ 12] getprop 45 .............................. <node>
  [ 14] getprop 244 ............................. <home>
  [ 16] pusharglistnoret 2 ...................... <node, home>
  [ 18] objcall 135 ............................. node.setLoc(home)
  [ 20] ret
end

on destroy me
  [  0] getparam 0 .............................. <me>
  [  2] pushsymb 117 ............................ <#exitFrame>
  [  4] pusharglistnoret 2 ...................... <me, #exitFrame>
  [  6] extcall 105 ............................. unsubscribe(me, #exitFrame)
  [  8] pushzero ................................ <0>
  [  9] setprop 1143 ............................ moving = 0
  [ 12] pusharglist 0 ........................... <>
  [ 14] extcall 65 .............................. <VOID>
  [ 16] setprop 45 .............................. node = VOID
  [ 18] ret
end
