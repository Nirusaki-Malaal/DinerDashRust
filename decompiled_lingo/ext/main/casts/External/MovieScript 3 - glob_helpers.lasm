  [ 13] jmp [ 24]
  [ 16] pushcons 12 ............................. <"hide_alerts">
  [ 18] pusharglist 1 ........................... <"hide_alerts">
  [ 20] extcall 20 .............................. <script("hide_alerts")>
  [ 22] setmovieprop 111 ........................ the alertHook = script("hide_alerts")
  [ 24] ret
end
