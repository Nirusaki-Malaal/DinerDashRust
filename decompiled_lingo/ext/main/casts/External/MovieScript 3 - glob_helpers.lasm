on refreshConfigs me
  [  0] pushcons 1 .............................. <"refreshing configs...">
  [  2] pusharglistnoret 1 ...................... <"refreshing configs...">
  [  4] extcall 42 .............................. put "refreshing configs..."
  [  6] pushcons 2 .............................. <"global">
  [  8] pushcons 3 .............................. <"career">
  [ 10] pushcons 4 .............................. <"endless">
  [ 12] pushcons 5 .............................. <"powerups">
  [ 14] pushcons 6 .............................. <"customer">
  [ 16] pusharglist 5 ........................... <["global", "career", "endless", "powerups", "customer"]>
  [ 18] pushlist ................................ <["global", "career", "endless", "powerups", "customer"]>
  [ 19] peek 0
  [ 21] pusharglist 1
  [ 23] extcall 41
  [ 25] pushint8 1
  [ 27] peek 0
  [ 29] peek 2
  [ 31] lteq
  [ 32] jmpifz [105] ............................ repeat with i in ["global", "career", "endless", "powerups", "customer"]
  [ 35] peek 2
  [ 37] peek 1
  [ 39] pusharglist 2
  [ 41] extcall 33
  [ 43] setlocal 0
  [ 45] pushcons 7 .............................. <"_date">
  [ 47] pushcons 8 .............................. <"_dump">
  [ 49] pusharglist 2 ........................... <["_date", "_dump"]>
  [ 51] pushlist ................................ <["_date", "_dump"]>
  [ 52] peek 0
  [ 54] pusharglist 1
  [ 56] extcall 41
  [ 58] pushint8 1
  [ 60] peek 0
  [ 62] peek 2
  [ 64] lteq
  [ 65] jmpifz [ 98] ............................ repeat with j in ["_date", "_dump"]
  [ 68] peek 2
  [ 70] peek 1
  [ 72] pusharglist 2
  [ 74] extcall 33
  [ 76] setlocal 1
  [ 78] getlocal 0 .............................. <i>
  [ 80] getlocal 1 .............................. <j>
  [ 82] joinstr ................................. <i & j>
  [ 83] pushcons 9 .............................. <"scripts.config">
  [ 85] pusharglist 2 ........................... <i & j, "scripts.config">
  [ 87] extcall 61 .............................. <member(i & j, "scripts.config")>
  [ 89] pushcons 10 ............................. <EMPTY>
  [ 91] setobjprop 69 ........................... member(i & j, "scripts.config").text = EMPTY
  [ 93] pushint8 1
  [ 95] add
  [ 96] endrepeat [ 60]
  [ 98] pop 3
  [100] pushint8 1
  [102] add
  [103] endrepeat [ 27]
  [105] pop 3
  [107] ret
end

