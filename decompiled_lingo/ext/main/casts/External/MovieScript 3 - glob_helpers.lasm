on setalert bool
  [  0] getparam 0 .............................. <bool>
  [  2] jmpifz [ 16] ............................ if bool then / else
  [  5] pushcons 11 ............................. <"show_alerts">
  [  7] pusharglist 1 ........................... <"show_alerts">
  [  9] extcall 20 .............................. <script("show_alerts")>
