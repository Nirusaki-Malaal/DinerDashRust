  [ 65] pusharglist 1 ........................... <dstring.item[1]>
  [ 67] extcall 175 ............................. <integer(dstring.item[1])>
  [ 69] getlocal 0 .............................. <dstring>
  [ 71] pushsymb 283 ............................ <#item>
  [ 74] pushint8 2 .............................. <2>
  [ 76] pusharglist 3 ........................... <dstring, #item, 2>
  [ 78] objcall 63 .............................. <dstring.item[2]>
  [ 80] pusharglist 1 ........................... <dstring.item[2]>
  [ 82] extcall 175 ............................. <integer(dstring.item[2])>
  [ 84] pusharglist 3 ........................... <integer(dstring.item[3]), integer(dstring.item[1]), integer(dstring.item[2])>
  [ 86] extcall 281 ............................. <date(integer(dstring.item[3]), integer(dstring.item[1]), integer(dstring.item[2]))>
  [ 89] setlocal 2 .............................. today = date(integer(dstring.item[3]), integer(dstring.item[1]), integer(dstring.item[2]))
  [ 91] getlocal 1 .............................. <i>
  [ 93] setmovieprop 282 ........................ the itemDelimiter = i
  [ 96] getparam 2 .............................. <y>
  [ 98] getparam 0 .............................. <m>
  [100] getparam 1 .............................. <d>
  [102] pusharglist 3 ........................... <y, m, d>
  [104] extcall 281 ............................. <date(y, m, d)>
  [107] getlocal 2 .............................. <today>
