  [402] setlocal 0 .............................. r = r & "]" & RETURN
  [404] jmp [459]
  [407] peek 0
  [409] pushsymb 181 ............................ <#string>
  [411] eq
  [412] jmpifz [431] ............................ (case) #string:
  [415] getlocal 0 .............................. <r>
  [417] pushcons 110 ............................ <QUOTE>
  [419] joinstr ................................. <r & QUOTE>
  [420] getparam 0 .............................. <L>
  [422] joinstr ................................. <r & QUOTE & L>
  [423] pushcons 110 ............................ <QUOTE>
  [425] joinstr ................................. <r & QUOTE & L & QUOTE>
  [426] setlocal 0 .............................. r = r & QUOTE & L & QUOTE
  [428] jmp [459]
  [431] peek 0
  [433] pushsymb 215 ............................ <#symbol>
  [435] eq
  [436] jmpifz [452] ............................ (case) #symbol:
  [439] getlocal 0 .............................. <r>
  [441] pushcons 118 ............................ <"#">
  [443] joinstr ................................. <r & "#">
  [444] getparam 0 .............................. <L>
  [446] joinstr ................................. <r & "#" & L>
  [447] setlocal 0 .............................. r = r & "#" & L
  [449] jmp [459] ............................... (case) otherwise:
  [452] getlocal 0 .............................. <r>
  [454] getparam 0 .............................. <L>
  [456] joinstr ................................. <r & L>
  [457] setlocal 0 .............................. r = r & L
  [459] pop 1 ................................... end case
  [461] getlocal 0 .............................. <r>
  [463] pusharglistnoret 1 ...................... <r>
  [465] extcall 35 .............................. return r
  [467] ret
end

on pindent n
  [  0] pushcons 0 .............................. <EMPTY>
  [  2] setlocal 0 .............................. r = EMPTY
  [  4] pushint8 1 .............................. <1>
  [  6] setlocal 1
  [  8] getlocal 1
  [ 10] getparam 0 .............................. <n>
  [ 12] lteq
  [ 13] jmpifz [ 32] ............................ repeat with i = 1 to n
  [ 16] getlocal 0 .............................. <r>
  [ 18] pushcons 119 ............................ <" ">
  [ 20] joinstr ................................. <r & " ">
  [ 21] setlocal 0 .............................. r = r & " "
  [ 23] pushint8 1
  [ 25] getlocal 1
  [ 27] add
  [ 28] setlocal 1
  [ 30] endrepeat [  8]
  [ 32] getlocal 0 .............................. <r>
  [ 34] pusharglistnoret 1 ...................... <r>
  [ 36] extcall 35 .............................. return r
  [ 38] ret
end
