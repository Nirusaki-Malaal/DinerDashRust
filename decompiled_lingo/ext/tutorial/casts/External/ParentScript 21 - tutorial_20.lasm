property done, flo, sitterGroups
global glob

on startStep me
  [  0] pushzero ................................ <0>
  [  1] setprop 66 .............................. done = 0
  [  3] getglobal 8 ............................. <glob>
  [  5] getchainedprop 9 ........................ <glob.managers>
  [  7] getchainedprop 10 ....................... <glob.managers.game>
  [  9] getchainedprop 11 ....................... <glob.managers.game.room>
  [ 11] getobjprop 96 ........................... <glob.managers.game.room.sitterGroups>
  [ 13] setprop 96 .............................. sitterGroups = glob.managers.game.room.sitterGroups
  [ 15] getprop 96 .............................. <sitterGroups>
  [ 17] getobjprop 59 ........................... <sitterGroups.count>
  [ 19] pushint8 2 .............................. <2>
  [ 21] nteq .................................... <sitterGroups.count <> 2>
  [ 22] jmpifz [ 29] ............................ if sitterGroups.count <> 2 then
  [ 25] pusharglistnoret 0 ...................... <>
  [ 27] extcall 44 .............................. return 
  [ 29] getglobal 8 ............................. <glob>
  [ 31] getchainedprop 9 ........................ <glob.managers>
  [ 33] getchainedprop 10 ....................... <glob.managers.game>
  [ 35] getchainedprop 11 ....................... <glob.managers.game.room>
  [ 37] getobjprop 79 ........................... <glob.managers.game.room.waiter>
  [ 39] setprop 78 .............................. flo = glob.managers.game.room.waiter
  [ 41] pushint8 1 .............................. <1>
  [ 43] pusharglistnoret 1 ...................... <1>
  [ 45] extcall 44 .............................. return 1
  [ 47] ret
end

on checkDone me
  [  0] getprop 66 .............................. <done>
  [  2] jmpifz [  9] ............................ if done then
  [  5] pusharglistnoret 0 ...................... <>
  [  7] extcall 44 .............................. return 
  [  9] pushint8 1 .............................. <1>
  [ 11] setlocal 0 .............................. gottenFood = 1
  [ 13] getprop 96 .............................. <sitterGroups>
  [ 15] peek 0
  [ 17] pusharglist 1
  [ 19] extcall 59
  [ 21] pushint8 1
  [ 23] peek 0
  [ 25] peek 2
  [ 27] lteq
  [ 28] jmpifz [ 70] ............................ repeat with s in sitterGroups
  [ 31] peek 2
  [ 33] peek 1
  [ 35] pusharglist 2
  [ 37] extcall 25
  [ 39] setlocal 1
  [ 41] getlocal 1 .............................. <s>
  [ 43] getchainedprop 74 ....................... <s.state>
  [ 45] getobjprop 75 ........................... <s.state.name>
  [ 47] setlocal 2 .............................. nm = s.state.name
  [ 49] getlocal 0 .............................. <gottenFood>
  [ 51] getlocal 2 .............................. <nm>
  [ 53] pushsymb 87 ............................. <#eating>
  [ 55] eq ...................................... <nm = #eating>
  [ 56] getlocal 2 .............................. <nm>
  [ 58] pushsymb 88 ............................. <#check>
  [ 60] eq ...................................... <nm = #check>
  [ 61] or ...................................... <(nm = #eating) or (nm = #check)>
  [ 62] and ..................................... <gottenFood and ((nm = #eating) or (nm = #check))>
  [ 63] setlocal 0 .............................. gottenFood = gottenFood and ((nm = #eating) or (nm = #check))
  [ 65] pushint8 1
  [ 67] add
  [ 68] endrepeat [ 23]
  [ 70] pop 3
  [ 72] getprop 78 .............................. <flo>
  [ 74] pushsymb 86 ............................. <#food>
  [ 76] pusharglist 2 ........................... <flo, #food>
  [ 78] objcall 81 .............................. <flo.hasPayloadType(#food)>
  [ 80] not ..................................... <not flo.hasPayloadType(#food)>
  [ 81] getlocal 0 .............................. <gottenFood>
  [ 83] and ..................................... <not flo.hasPayloadType(#food) and gottenFood>
  [ 84] setprop 66 .............................. done = not flo.hasPayloadType(#food) and gottenFood
  [ 86] getprop 66 .............................. <done>
  [ 88] pusharglistnoret 1 ...................... <done>
  [ 90] extcall 44 .............................. return done
  [ 92] ret
end
