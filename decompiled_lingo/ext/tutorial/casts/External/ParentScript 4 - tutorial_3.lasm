property sitterGroup, done
global glob

on startStep me
  [  0] pushzero ................................ <0>
  [  1] setprop 66 .............................. done = 0
  [  3] getglobal 8 ............................. <glob>
  [  5] getchainedprop 9 ........................ <glob.managers>
  [  7] getchainedprop 10 ....................... <glob.managers.game>
  [  9] getchainedprop 11 ....................... <glob.managers.game.room>
  [ 11] getobjprop 70 ........................... <glob.managers.game.room.tables>
  [ 13] setlocal 0 .............................. t = glob.managers.game.room.tables
  [ 15] getlocal 0 .............................. <t>
  [ 17] getobjprop 59 ........................... <t.count>
  [ 19] pushint8 2 .............................. <2>
  [ 21] nteq .................................... <t.count <> 2>
  [ 22] jmpifz [ 29] ............................ if t.count <> 2 then
  [ 25] pusharglistnoret 0 ...................... <>
  [ 27] extcall 44 .............................. return 
  [ 29] getlocal 0 .............................. <t>
  [ 31] pushint8 2 .............................. <2>
  [ 33] pusharglist 2 ........................... <t, 2>
  [ 35] objcall 25 .............................. <t[2]>
  [ 37] getobjprop 73 ........................... <t[2].sitterGroup>
  [ 39] setprop 73 .............................. sitterGroup = t[2].sitterGroup
  [ 41] pushint8 1 .............................. <1>
  [ 43] pusharglistnoret 1 ...................... <1>
  [ 45] extcall 44 .............................. return 1
  [ 47] ret
end

on checkDone me
  [  0] getprop 66 .............................. <done>
  [  2] getprop 73 .............................. <sitterGroup>
  [  4] pusharglist 1 ........................... <sitterGroup>
  [  6] extcall 26 .............................. <voidp(sitterGroup)>
  [  8] or ...................................... <done or voidp(sitterGroup)>
  [  9] jmpifz [ 16] ............................ if done or voidp(sitterGroup) then
  [ 12] pusharglistnoret 0 ...................... <>
  [ 14] extcall 44 .............................. return 
  [ 16] getprop 73 .............................. <sitterGroup>
  [ 18] getchainedprop 74 ....................... <sitterGroup.state>
  [ 20] getobjprop 75 ........................... <sitterGroup.state.name>
  [ 22] pushsymb 76 ............................. <#ready>
  [ 24] eq ...................................... <sitterGroup.state.name = #ready>
  [ 25] setprop 66 .............................. done = sitterGroup.state.name = #ready
  [ 27] getprop 66 .............................. <done>
  [ 29] pusharglistnoret 1 ...................... <done>
  [ 31] extcall 44 .............................. return done
  [ 33] ret
end
