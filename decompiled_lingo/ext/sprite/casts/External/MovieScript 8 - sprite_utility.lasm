  [ 85] extcall 19 .............................. return n
  [ 87] pushint8 1
  [ 89] add
  [ 90] endrepeat [ 43]
  [ 92] pop 3
  [ 94] ret
end

on setSpriteVis vis, rng
  [  0] getparam 1 .............................. <rng>
  [  2] pusharglist 1 ........................... <rng>
  [  4] extcall 41 .............................. <voidp(rng)>
  [  6] jmpifz [ 18] ............................ if voidp(rng) then
  [  9] pushint8 1 .............................. <1>
  [ 11] getmovieprop 107 ........................ <the lastChannel>
  [ 13] pusharglist 2 ........................... <[1, the lastChannel]>
  [ 15] pushlist ................................ <[1, the lastChannel]>
  [ 16] setparam 1 .............................. rng = [1, the lastChannel]
  [ 18] getparam 1 .............................. <rng>
  [ 20] pushint8 1 .............................. <1>
  [ 22] pusharglist 2 ........................... <rng, 1>
  [ 24] objcall 44 .............................. <rng[1]>
  [ 26] setlocal 0
  [ 28] getlocal 0
  [ 30] getparam 1 .............................. <rng>
  [ 32] pushint8 2 .............................. <2>
  [ 34] pusharglist 2 ........................... <rng, 2>
  [ 36] objcall 44 .............................. <rng[2]>
  [ 38] lteq
  [ 39] jmpifz [ 61] ............................ repeat with i = rng[1] to rng[2]
  [ 42] getlocal 0 .............................. <i>
  [ 44] pusharglist 1 ........................... <i>
  [ 46] extcall 108 ............................. <sprite(i)>
  [ 48] getparam 0 .............................. <vis>
  [ 50] setobjprop 113 .......................... sprite(i).visible = vis
  [ 52] pushint8 1
  [ 54] getlocal 0
  [ 56] add
  [ 57] setlocal 0
  [ 59] endrepeat [ 28]
  [ 61] ret
end
