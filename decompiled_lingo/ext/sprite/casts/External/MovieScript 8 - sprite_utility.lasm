  [  4] pushsymb 109 ............................ <#leaf>
  [  6] eq ...................................... <node.type = #leaf>
  [  7] jmpifz [ 31] ............................ if node.type = #leaf then / else
  [ 10] getparam 1 .............................. <node>
  [ 12] getchainedprop 110 ...................... <node.pSprite>
  [ 14] getobjprop 111 .......................... <node.pSprite.spriteNum>
  [ 16] getparam 0 .............................. <spr>
  [ 18] eq ...................................... <node.pSprite.spriteNum = spr>
  [ 19] jmpifz [ 28] ............................ if node.pSprite.spriteNum = spr then
  [ 22] getparam 1 .............................. <node>
  [ 24] pusharglistnoret 1 ...................... <node>
  [ 26] extcall 19 .............................. return node
  [ 28] jmp [ 94]
  [ 31] getparam 1 .............................. <node>
  [ 33] getobjprop 34 ........................... <node.children>
  [ 35] peek 0
  [ 37] pusharglist 1
  [ 39] extcall 48
  [ 41] pushint8 1
  [ 43] peek 0
