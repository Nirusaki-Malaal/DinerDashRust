  [ 44] jmpifz [ 65] ............................ if not dat[#noSprite] or voidp(dat[#member]) or (dat[#type] = #Branch) then
  [ 47] pushcons 0 .............................. <"node2d_branch">
  [ 49] pusharglist 1 ........................... <"node2d_branch">
  [ 51] extcall 24 .............................. <script("node2d_branch")>
