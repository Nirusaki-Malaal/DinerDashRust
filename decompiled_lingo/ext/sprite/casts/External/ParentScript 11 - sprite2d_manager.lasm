property glob, sprites, spriteRange, offscreen
global numcalls, totaltime, avgtime, maxtime

on new me, g
  [  0] pushint16 5000 .......................... <5000>
  [  3] inv ..................................... <-5000>
  [  4] pushint16 5000 .......................... <5000>
  [  7] inv ..................................... <-5000>
  [  8] pusharglist 2 ........................... <-5000, -5000>
  [ 10] extcall 32 .............................. <point(-5000, -5000)>
  [ 12] setprop 124 ............................. offscreen = point(-5000, -5000)
  [ 14] getparam 1 .............................. <g>
  [ 16] setprop 42 .............................. glob = g
  [ 18] pushint8 11 ............................. <11>
  [ 20] pushint16 999 ........................... <999>
  [ 23] pusharglist 2 ........................... <[11, 999]>
  [ 25] pushlist ................................ <[11, 999]>
  [ 26] setprop 125 ............................. spriteRange = [11, 999]
  [ 28] pusharglist 0 ........................... <[]>
  [ 30] pushlist ................................ <[]>
  [ 31] setprop 126 ............................. sprites = []
  [ 33] getparam 0 .............................. <me>
  [ 35] pusharglistnoret 1 ...................... <me>
  [ 37] objcall 121 ............................. me.makePools()
  [ 39] getparam 0 .............................. <me>
  [ 41] pusharglistnoret 1 ...................... <me>
  [ 43] extcall 19 .............................. return me
  [ 45] ret
end

on makePools me
  [  0] getmovieprop 127 ........................ <the milliSeconds>
  [  2] setlocal 0 .............................. m = the milliSeconds
  [  4] getprop 125 ............................. <spriteRange>
  [  6] pushint8 1 .............................. <1>
  [  8] pusharglist 2 ........................... <spriteRange, 1>
  [ 10] objcall 44 .............................. <spriteRange[1]>
  [ 12] setlocal 1
  [ 14] getlocal 1
  [ 16] getprop 125 ............................. <spriteRange>
  [ 18] pushint8 2 .............................. <2>
  [ 20] pusharglist 2 ........................... <spriteRange, 2>
  [ 22] objcall 44 .............................. <spriteRange[2]>
  [ 24] lteq
  [ 25] jmpifz [ 59] ............................ repeat with i = spriteRange[1] to spriteRange[2]
  [ 28] getlocal 1 .............................. <i>
  [ 30] pusharglist 1 ........................... <i>
  [ 32] extcall 108 ............................. <sprite(i)>
  [ 34] setlocal 2 .............................. s = sprite(i)
  [ 36] getlocal 2 .............................. <s>
  [ 38] pushint8 1 .............................. <1>
  [ 40] setobjprop 128 .......................... s.puppet = 1
  [ 42] getprop 126 ............................. <sprites>
  [ 44] getlocal 2 .............................. <s>
  [ 46] pusharglistnoret 2 ...................... <sprites, s>
  [ 48] objcall 129 ............................. sprites.add(s)
  [ 50] pushint8 1
  [ 52] getlocal 1
  [ 54] add
  [ 55] setlocal 1
  [ 57] endrepeat [ 14]
  [ 59] ret
end

on getSprite me
  [  0] getprop 126 ............................. <sprites>
  [  2] getobjprop 48 ........................... <sprites.count>
  [  4] pushzero ................................ <0>
  [  5] eq ...................................... <sprites.count = 0>
  [  6] jmpifz [ 19] ............................ if sprites.count = 0 then
  [  9] pushcons 0 .............................. <"out of sprites">
  [ 11] pusharglistnoret 1 ...................... <"out of sprites">
  [ 13] extcall 132 ............................. complain("out of sprites")
  [ 15] pusharglistnoret 0 ...................... <>
  [ 17] extcall 19 .............................. return 
  [ 19] getprop 126 ............................. <sprites>
  [ 21] pushint8 1 .............................. <1>
  [ 23] pusharglist 2 ........................... <sprites, 1>
  [ 25] objcall 44 .............................. <sprites[1]>
  [ 27] setlocal 0 .............................. s = sprites[1]
  [ 29] getlocal 0 .............................. <s>
  [ 31] pushzero ................................ <0>
  [ 32] setobjprop 133 .......................... s.backColor = 0
  [ 34] getlocal 0 .............................. <s>
  [ 36] pushint16 255 ........................... <255>
  [ 39] setobjprop 134 .......................... s.foreColor = 255
  [ 41] getlocal 0 .............................. <s>
  [ 43] pushint16 255 ........................... <255>
  [ 46] pushint16 255 ........................... <255>
  [ 49] pushint16 255 ........................... <255>
  [ 52] pusharglist 3 ........................... <255, 255, 255>
  [ 54] extcall 135 ............................. <rgb(255, 255, 255)>
  [ 56] setobjprop 136 .......................... s.bgColor = rgb(255, 255, 255)
  [ 58] getlocal 0 .............................. <s>
  [ 60] pushzero ................................ <0>
  [ 61] pushzero ................................ <0>
  [ 62] pushzero ................................ <0>
  [ 63] pusharglist 3 ........................... <0, 0, 0>
  [ 65] extcall 135 ............................. <rgb(0, 0, 0)>
  [ 67] setobjprop 137 .......................... s.color = rgb(0, 0, 0)
  [ 69] getlocal 0 .............................. <s>
  [ 71] pushint16 5000 .......................... <5000>
  [ 74] inv ..................................... <-5000>
  [ 75] pushint16 5000 .......................... <5000>
  [ 78] inv ..................................... <-5000>
  [ 79] pusharglist 2 ........................... <-5000, -5000>
  [ 81] extcall 32 .............................. <point(-5000, -5000)>
  [ 83] setobjprop 31 ........................... s.loc = point(-5000, -5000)
  [ 85] getprop 126 ............................. <sprites>
  [ 87] pushint8 1 .............................. <1>
  [ 89] pusharglistnoret 2 ...................... <sprites, 1>
  [ 91] objcall 138 ............................. sprites.deleteAt(1)
  [ 93] getlocal 0 .............................. <s>
  [ 95] pusharglistnoret 1 ...................... <s>
  [ 97] extcall 19 .............................. return s
  [ 99] ret
end

on returnSprite me, s
  [  0] getparam 1 .............................. <s>
  [  2] getobjprop 139 .......................... <s.ilk>
  [  4] pushsymb 108 ............................ <#sprite>
  [  6] nteq .................................... <s.ilk <> #sprite>
  [  7] jmpifz [ 16] ............................ if s.ilk <> #sprite then
  [ 10] pushcons 1 .............................. <"tried to return something not a sprite">
  [ 12] pusharglistnoret 1 ...................... <"tried to return something not a sprite">
  [ 14] extcall 132 ............................. complain("tried to return something not a sprite")
  [ 16] getprop 126 ............................. <sprites>
  [ 18] getparam 1 .............................. <s>
  [ 20] pusharglist 2 ........................... <sprites, s>
  [ 22] objcall 140 ............................. <sprites.getOne(s)>
  [ 24] pushzero ................................ <0>
  [ 25] nteq .................................... <sprites.getOne(s) <> 0>
  [ 26] jmpifz [ 39] ............................ if sprites.getOne(s) <> 0 then
  [ 29] pushcons 2 .............................. <"tried to return a sprite already in pool">
  [ 31] pusharglistnoret 1 ...................... <"tried to return a sprite already in pool">
  [ 33] extcall 132 ............................. complain("tried to return a sprite already in pool")
  [ 35] pusharglistnoret 0 ...................... <>
  [ 37] extcall 19 .............................. return 
  [ 39] getparam 1 .............................. <s>
  [ 41] getchainedprop 99 ....................... <s.member>
  [ 43] getobjprop 141 .......................... <s.member.name>
  [ 45] pushcons 3 .............................. <"bar_bg">
  [ 47] eq ...................................... <s.member.name = "bar_bg">
  [ 48] jmpifz [ 55] ............................ if s.member.name = "bar_bg" then
  [ 51] pusharglistnoret 0 ...................... <>
  [ 53] extcall 142 ............................. nothing()
  [ 55] getparam 1 .............................. <s>
  [ 57] getchainedprop 143 ...................... <s.scriptInstanceList>
  [ 59] pusharglistnoret 1 ...................... <s.scriptInstanceList>
  [ 61] objcall 144 ............................. s.scriptInstanceList.deleteAll()
  [ 63] getparam 1 .............................. <s>
  [ 65] pushzero ................................ <0>
  [ 66] setobjprop 133 .......................... s.backColor = 0
  [ 68] getparam 1 .............................. <s>
  [ 70] pushint16 255 ........................... <255>
  [ 73] setobjprop 134 .......................... s.foreColor = 255
  [ 75] getparam 1 .............................. <s>
  [ 77] pushint16 255 ........................... <255>
  [ 80] pushint16 255 ........................... <255>
  [ 83] pushint16 255 ........................... <255>
  [ 86] pusharglist 3 ........................... <255, 255, 255>
  [ 88] extcall 135 ............................. <rgb(255, 255, 255)>
  [ 90] setobjprop 136 .......................... s.bgColor = rgb(255, 255, 255)
  [ 92] getparam 1 .............................. <s>
  [ 94] pushzero ................................ <0>
  [ 95] pushzero ................................ <0>
  [ 96] pushzero ................................ <0>
  [ 97] pusharglist 3 ........................... <0, 0, 0>
  [ 99] extcall 135 ............................. <rgb(0, 0, 0)>
  [101] setobjprop 137 .......................... s.color = rgb(0, 0, 0)
  [103] getparam 1 .............................. <s>
  [105] pushzero ................................ <0>
  [106] pusharglist 1 ........................... <0>
  [108] extcall 99 .............................. <member(0)>
  [110] setobjprop 99 ........................... s.member = member(0)
  [112] getparam 1 .............................. <s>
  [114] getprop 124 ............................. <offscreen>
  [116] setobjprop 31 ........................... s.loc = offscreen
  [118] getprop 126 ............................. <sprites>
  [120] getparam 1 .............................. <s>
  [122] pusharglistnoret 2 ...................... <sprites, s>
  [124] objcall 129 ............................. sprites.add(s)
  [126] ret
end

on init me
  [  0] ret
end

on destroy me
  [  0] getprop 126 ............................. <sprites>
  [  2] pusharglistnoret 1 ...................... <sprites>
  [  4] objcall 144 ............................. sprites.deleteAll()
  [  6] ret
end
