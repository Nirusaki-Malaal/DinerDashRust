  [ 10] getlocal 0 .............................. <m>
  [ 12] pusharglist 1 ........................... <m>
  [ 14] extcall 39 .............................. <voidp(m)>
  [ 16] jmpifz [ 32] ............................ if voidp(m) then
  [ 19] pushcons 2 .............................. <"no mode called ">
  [ 21] getparam 1 .............................. <sym>
  [ 23] joinstr ................................. <"no mode called " & sym>
  [ 24] pusharglistnoret 1 ...................... <"no mode called " & sym>
  [ 26] extcall 40 .............................. complain("no mode called " & sym)
  [ 28] pusharglistnoret 0 ...................... <>
  [ 30] extcall 9 ............................... return 
  [ 32] getprop 41 .............................. <currentMode>
  [ 34] getlocal 0 .............................. <m>
  [ 36] eq ...................................... <currentMode = m>
  [ 37] jmpifz [ 44] ............................ if currentMode = m then
  [ 40] pusharglistnoret 0 ...................... <>
  [ 42] extcall 9 ............................... return 
  [ 44] getprop 41 .............................. <currentMode>
  [ 46] pusharglist 1 ........................... <currentMode>
  [ 48] extcall 39 .............................. <voidp(currentMode)>
  [ 50] not ..................................... <not voidp(currentMode)>
  [ 51] getparam 1 .............................. <sym>
  [ 53] pushsymb 25 ............................. <#quit>
  [ 55] nteq .................................... <sym <> #quit>
  [ 56] and ..................................... <not voidp(currentMode) and (sym <> #quit)>
  [ 57] getparam 1 .............................. <sym>
  [ 59] pushsymb 26 ............................. <#pause>
  [ 61] nteq .................................... <sym <> #pause>
  [ 62] and ..................................... <not voidp(currentMode) and (sym <> #quit) and (sym <> #pause)>
  [ 63] jmpifz [ 74] ............................ if not voidp(currentMode) and (sym <> #quit) and (sym <> #pause) then
  [ 66] getprop 41 .............................. <currentMode>
  [ 68] getlocal 0 .............................. <m>
  [ 70] pusharglistnoret 2 ...................... <currentMode, m>
  [ 72] objcall 42 .............................. currentMode.leaveMode(m)
  [ 74] getparam 3 .............................. <revert>
  [ 76] not ..................................... <not revert>
  [ 77] jmpifz [ 90] ............................ if not revert then
  [ 80] getlocal 0 .............................. <m>
  [ 82] getprop 41 .............................. <currentMode>
  [ 84] getparam 2 .............................. <data>
  [ 86] pusharglistnoret 3 ...................... <m, currentMode, data>
  [ 88] objcall 43 .............................. m.enterMode(currentMode, data)
  [ 90] getlocal 0 .............................. <m>
  [ 92] setprop 41 .............................. currentMode = m
  [ 94] ret
end
