  [ 38] pushlist ................................ <[#comic, #menu, #transform_comic, #end_comic, #endless, #login, #endless_shop, #career, #hiscore, #startstage, #startLevel, #play, #endlevel, #quit, #pause, #pre_hiscore, #help, #options]>
  [ 39] peek 0
