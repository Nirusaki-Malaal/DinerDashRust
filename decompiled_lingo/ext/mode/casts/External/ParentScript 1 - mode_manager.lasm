  [ 55] peek 2
  [ 57] peek 1
  [ 59] pusharglist 2
  [ 61] extcall 31
  [ 63] setlocal 0
  [ 65] getprop 8 ............................... <modes>
  [ 67] getlocal 0 .............................. <i>
  [ 69] pushcons 0 .............................. <"mode.">
  [ 71] getlocal 0 .............................. <i>
  [ 73] pusharglist 1 ........................... <i>
  [ 75] extcall 33 .............................. <string(i)>
  [ 77] joinstr ................................. <"mode." & string(i)>
  [ 78] pushcons 1 .............................. <"scripts.mode">
  [ 80] pusharglist 2 ........................... <"mode." & string(i), "scripts.mode">
  [ 82] extcall 32 .............................. <script("mode." & string(i), "scripts.mode")>
  [ 84] getparam 0 .............................. <me>
  [ 86] pusharglist 2 ........................... <script("mode." & string(i), "scripts.mode"), me>
  [ 88] objcall 0 ............................... <script("mode." & string(i), "scripts.mode").new(me)>
  [ 90] pusharglistnoret 3 ...................... <modes, i, script("mode." & string(i), "scripts.mode").new(me)>
  [ 92] objcall 34 .............................. modes[i] = script("mode." & string(i), "scripts.mode").new(me)
  [ 94] pushint8 1
  [ 96] add
  [ 97] endrepeat [ 47]
  [ 99] pop 3
  [101] ret
end

on destroy me
  [  0] pushsymb 2 .............................. <#destroy>
  [  2] getprop 8 ............................... <modes>
  [  4] pusharglistnoret 2 ...................... <#destroy, modes>
  [  6] extcall 36 .............................. call(#destroy, modes)
  [  8] getprop 8 ............................... <modes>
  [ 10] pusharglistnoret 1 ...................... <modes>
  [ 12] objcall 37 .............................. modes.deleteAll()
  [ 14] pusharglist 0 ........................... <>
  [ 16] extcall 38 .............................. <VOID>
  [ 18] setprop 4 ............................... glob = VOID
