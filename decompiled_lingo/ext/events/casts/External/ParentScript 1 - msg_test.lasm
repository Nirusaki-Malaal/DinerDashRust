property mgr, num

on new me, m, n
  [  0] getparam 2 .............................. <n>
  [  2] setprop 5 ............................... num = n
  [  4] getparam 1 .............................. <m>
  [  6] setprop 6 ............................... mgr = m
  [  8] getprop 6 ............................... <mgr>
  [ 10] getparam 0 .............................. <me>
  [ 12] pushsymb 3 .............................. <#doit1>
  [ 14] pusharglistnoret 3 ...................... <mgr, me, #doit1>
  [ 16] objcall 7 ............................... mgr.subscribe(me, #doit1)
  [ 18] getparam 0 .............................. <me>
  [ 20] pusharglistnoret 1 ...................... <me>
  [ 22] extcall 8 ............................... return me
  [ 24] ret
end

on destroy me
  [  0] getprop 6 ............................... <mgr>
  [  2] getparam 0 .............................. <me>
  [  4] pusharglistnoret 2 ...................... <mgr, me>
  [  6] objcall 12 .............................. mgr.unsubscribeAll(me)
  [  8] ret
end

on test scr
  [  0] pushcons 0 .............................. <"message_manager">
  [  2] pusharglist 1 ........................... <"message_manager">
  [  4] extcall 13 .............................. <script("message_manager")>
  [  6] pusharglist 1 ........................... <script("message_manager")>
  [  8] objcall 0 ............................... <script("message_manager").new()>
  [ 10] setlocal 0 .............................. m = script("message_manager").new()
  [ 12] pusharglist 0 ........................... <[]>
  [ 14] pushlist ................................ <[]>
  [ 15] setlocal 1 .............................. ls = []
  [ 17] pushint8 1 .............................. <1>
  [ 19] setlocal 2
  [ 21] getlocal 2
  [ 23] pushint8 10 ............................. <10>
  [ 25] lteq
  [ 26] jmpifz [ 54] ............................ repeat with i = 1 to 10
  [ 29] getlocal 1 .............................. <ls>
  [ 31] getparam 0 .............................. <scr>
  [ 33] getlocal 0 .............................. <m>
  [ 35] getlocal 2 .............................. <i>
  [ 37] pusharglist 3 ........................... <scr, m, i>
  [ 39] objcall 0 ............................... <scr.new(m, i)>
  [ 41] pusharglistnoret 2 ...................... <ls, scr.new(m, i)>
  [ 43] objcall 14 .............................. ls.add(scr.new(m, i))
  [ 45] pushint8 1
  [ 47] getlocal 2
  [ 49] add
  [ 50] setlocal 2
  [ 52] endrepeat [ 21]
  [ 54] getlocal 0 .............................. <m>
  [ 56] pushsymb 3 .............................. <#doit1>
  [ 58] pusharglistnoret 2 ...................... <m, #doit1>
  [ 60] objcall 15 .............................. m.sendMessage(#doit1)
  [ 62] getlocal 0 .............................. <m>
  [ 64] pushsymb 4 .............................. <#doit2>
  [ 66] pusharglistnoret 2 ...................... <m, #doit2>
  [ 68] objcall 15 .............................. m.sendMessage(#doit2)
  [ 70] getlocal 0 .............................. <m>
  [ 72] pushsymb 3 .............................. <#doit1>
  [ 74] pusharglistnoret 2 ...................... <m, #doit1>
  [ 76] objcall 15 .............................. m.sendMessage(#doit1)
  [ 78] pushsymb 1 .............................. <#destroy>
  [ 80] getlocal 1 .............................. <ls>
  [ 82] pusharglistnoret 2 ...................... <#destroy, ls>
  [ 84] extcall 16 .............................. call(#destroy, ls)
  [ 86] getlocal 1 .............................. <ls>
  [ 88] pusharglistnoret 1 ...................... <ls>
  [ 90] objcall 17 .............................. ls.deleteAll()
  [ 92] getlocal 0 .............................. <m>
  [ 94] pushsymb 3 .............................. <#doit1>
  [ 96] pusharglistnoret 2 ...................... <m, #doit1>
  [ 98] objcall 15 .............................. m.sendMessage(#doit1)
  [100] getlocal 0 .............................. <m>
  [102] pushsymb 4 .............................. <#doit2>
  [104] pusharglistnoret 2 ...................... <m, #doit2>
  [106] objcall 15 .............................. m.sendMessage(#doit2)
  [108] getlocal 0 .............................. <m>
  [110] pusharglistnoret 1 ...................... <m>
  [112] objcall 1 ............................... m.destroy()
  [114] pusharglist 0 ........................... <>
  [116] extcall 18 .............................. <VOID>
  [118] setlocal 0 .............................. m = VOID
  [120] ret
end

on doit1 me
  [  0] pushcons 1 .............................. <"obj">
  [  2] getprop 5 ............................... <num>
  [  4] pusharglist 1 ........................... <num>
  [  6] extcall 22 .............................. <string(num)>
  [  8] joinstr ................................. <"obj" & string(num)>
  [  9] pushcons 2 .............................. <".doit1()">
  [ 11] joinstr ................................. <"obj" & string(num) & ".doit1()">
  [ 12] pusharglistnoret 1 ...................... <"obj" & string(num) & ".doit1()">
  [ 14] extcall 23 .............................. put "obj" & string(num) & ".doit1()"
  [ 16] pushint8 2 .............................. <2>
  [ 18] pusharglist 1 ........................... <2>
  [ 20] extcall 24 .............................. <random(2)>
  [ 22] pushint8 1 .............................. <1>
  [ 24] eq ...................................... <random(2) = 1>
  [ 25] jmpifz [ 38] ............................ if random(2) = 1 then
  [ 28] getprop 6 ............................... <mgr>
  [ 30] getparam 0 .............................. <me>
  [ 32] pushsymb 3 .............................. <#doit1>
  [ 34] pusharglistnoret 3 ...................... <mgr, me, #doit1>
  [ 36] objcall 25 .............................. mgr.unsubscribe(me, #doit1)
  [ 38] pushint8 2 .............................. <2>
  [ 40] pusharglist 1 ........................... <2>
  [ 42] extcall 24 .............................. <random(2)>
  [ 44] pushint8 1 .............................. <1>
  [ 46] eq ...................................... <random(2) = 1>
  [ 47] jmpifz [ 60] ............................ if random(2) = 1 then
  [ 50] getprop 6 ............................... <mgr>
  [ 52] getparam 0 .............................. <me>
  [ 54] pushsymb 4 .............................. <#doit2>
  [ 56] pusharglistnoret 3 ...................... <mgr, me, #doit2>
  [ 58] objcall 7 ............................... mgr.subscribe(me, #doit2)
  [ 60] ret
end

on doit2 me
  [  0] pushcons 1 .............................. <"obj">
  [  2] getprop 5 ............................... <num>
  [  4] pusharglist 1 ........................... <num>
  [  6] extcall 22 .............................. <string(num)>
  [  8] joinstr ................................. <"obj" & string(num)>
  [  9] pushcons 3 .............................. <".doit2()">
  [ 11] joinstr ................................. <"obj" & string(num) & ".doit2()">
  [ 12] pusharglistnoret 1 ...................... <"obj" & string(num) & ".doit2()">
  [ 14] extcall 23 .............................. put "obj" & string(num) & ".doit2()"
